{
  "name": "motion-studio",
  "displayName": "Motion Studio",
  "description": "Motion Robotics Framework Visualization Tool",
  "version": "0.0.1",
  "publisher": "MeYaKo98",
  "repository": {
    "type": "git",
    "url": "https://github.com/MeYaKo98/MotionStudio.git"
  },
  "icon": "images/icon.png",
  "keywords": [
    "motion",
    "robotics",
    "device",
    "communication",
    "protocol",
    "serial",
    "TCP",
    "CLI",
    "control"
  ],
  "categories": [
    "Debuggers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "terminal": {
      "profiles": [
        {
          "id": "motion-studio.cli",
          "title": "Motion CLI",
          "icon": "terminal-view-icon"
        }
      ]
    },
    "commands": [
      {
        "command": "motion-studio.connect",
        "title": "Connect",
        "category": "Motion Link"
      },
      {
        "command": "motion-studio.disconnect",
        "title": "Disconnect",
        "category": "Motion Link"
      },
      {
        "command": "motion-studio.open-cli",
        "title": "Command Line Interface",
        "category": "Motion Link",
        "shortTitle": "CLI"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "motion-studio.connect",
          "when": "!motion-studio.isConnected"
        },
        {
          "command": "motion-studio.disconnect",
          "when": "motion-studio.isConnected"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "serialport": "^13.0.0"
  }
}
